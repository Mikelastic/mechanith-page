---
// src/layouts/BaseLayout.astro — v2 (B2): article SEO, RSS discovery, slash-canonicals
import '@fontsource/chakra-petch/300.css';
import '@fontsource/chakra-petch/400.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '../styles/global.css';
import OverlayTopBar from '../components/OverlayTopBar.astro';
import BuyButton from '../components/BuyButton.astro';
import FooterCTA from '../components/FooterCTA.astro';
import { SITE } from '../config/site';
import { defaultLocale, localizedPath, stripLocale, type Locale } from '../config/i18n';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  localized?: boolean;
  showTopBar?: boolean;
  showBuyButton?: boolean;
  showFooterCTA?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  locale = defaultLocale,
  localized = true,
  showTopBar = true,
  showBuyButton = true,
  showFooterCTA = true,
  ogType = 'website',
  publishedTime,
  ogImage,
} = Astro.props;

const pageTitle = title === SITE.title ? SITE.title : `${title} — ${SITE.title}`;

// Canonical/hreflang must use the trailing-slash form — it's the URL
// Cloudflare actually serves (the bare form 301s to it)
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const rootPath = stripLocale(Astro.url.pathname);
const canonical = new URL(withSlash(Astro.url.pathname), Astro.site);
const enUrl = new URL(withSlash(localizedPath('en', rootPath)), Astro.site);
const esUrl = new URL(withSlash(localizedPath('es', rootPath)), Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {localized && (
      <>
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Development notes`} href="/blog/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
  </head>
  <body>
    {/* LAYER 2 — fixed chrome, toggled per page */}
    {showTopBar && <OverlayTopBar locale={locale} localized={localized} />}
    {showBuyButton && <BuyButton locale={locale} />}

    {/* LAYER 1 — in-flow page content */}
    <main>
      <slot />
    </main>
    {showFooterCTA && <FooterCTA locale={locale} />}
  </body>
</html>