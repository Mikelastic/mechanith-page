---
import { navItems } from '../config/nav';
import { ui } from '../config/strings';
import { SITE } from '../config/site';

const t = ui.en;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="topbar">
  <a class="brand" href="/">{SITE.title}</a>

  <nav class="topnav" aria-label="Primary">
    {navItems.map((item) => (
      <a href={item.href} class:is-active={isActive(item.href)}>
        {t.nav[item.key]}
      </a>
    ))}
  </nav>

  <div class="lang">
    <button type="button" title="More languages coming">EN</button>
  </div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--topbar-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 1rem;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-line);
  }
  .brand {
    justify-self: start;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: var(--c-ink);
    text-decoration: none;
  }
  .topnav { display: flex; gap: 1.5rem; }
  .topnav a {
    color: var(--c-muted);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
  }
  .topnav a:hover { color: var(--c-ink); }
  .topnav a.is-active { color: var(--c-accent); border-bottom-color: var(--c-accent); }
  .lang { justify-self: end; }
  .lang button {
    background: none;
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.5rem;
    cursor: default;
  }
  @media (max-width: 720px) {
    .topnav { gap: 0.9rem; overflow-x: auto; }
    .topnav a { font-size: 0.72rem; letter-spacing: 0.08em; }
    .brand { font-size: 0.8rem; letter-spacing: 0.15em; }
  }
</style>