---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout title={SITE.title}>

  <!-- HERO — full viewport, centered, minimal, subtle animated grid -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <p class="eyebrow">The thinking player’s action rogue-like</p>
    <h1 class="title">MECHANITH</h1>
    <p class="sub">Master the swap. Survive the planet. Uncover what was lost.</p>
    <div class="cta">
      <a class="btn btn-primary" href="/link/steam">Wishlist on Steam</a>
      <a class="btn" href="/media">Watch the trailer</a>
    </div>
  </section>

  <!-- PITCH -->
  <section class="shell sec">
    <h2>Stranded. Swapping. Surviving.</h2>
    <p class="lead">
      Mechanith is a top-down, sci-fi rogue-like where you crash-land on a hostile
      alien planet and fight your way home. Chart procedurally generated biomes,
      spend resources at your crashed-ship hub to grow stronger, and unravel the
      secrets of a lost civilization.
    </p>
  </section>

  <!-- THE CORE MECHANIC -->
  <section class="shell sec">
    <h2>Symbiotic swapping</h2>
    <p class="lead">
      The central challenge is not just to execute — it is to constantly ask:
      <em>“Who is the right tool for this exact moment?”</em>
    </p>
    <div class="duo">
      <article class="char">
        <div class="portrait" role="img" aria-label="Portrait of Kael (placeholder)">KAEL</div>
        <h3>Kaelen — “Kael”</h3>
        <p>Nimble and gun-wielding. Fast, precise, fragile — the scalpel.</p>
      </article>
      <article class="char">
        <div class="portrait" role="img" aria-label="Portrait of A.X.L (placeholder)">A.X.L</div>
        <h3>A.X.L</h3>
        <p>Robust quadrupedal companion. Durable and deliberate — the hammer.</p>
      </article>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="shell sec">
    <h2>What awaits</h2>
    <ul class="pillars">
      <li><h3>Procedural biomes</h3><p>Treacherous, ever-changing alien landscapes.</p></li>
      <li><h3>Crashed-ship hub</h3><p>Spend resources. Grow stronger between runs.</p></li>
      <li><h3>A lost civilization</h3><p>Uncover its secrets. Find the way home.</p></li>
    </ul>
  </section>

  <!-- MEDIA TEASER -->
  <section class="shell sec last">
    <h2>From the planet</h2>
    <div class="shots">
      <div class="shot" role="img" aria-label="Screenshot placeholder">SCREENSHOT — TO COME</div>
      <div class="shot" role="img" aria-label="Screenshot placeholder">SCREENSHOT — TO COME</div>
      <div class="shot" role="img" aria-label="Screenshot placeholder">SCREENSHOT — TO COME</div>
      <div class="shot" role="img" aria-label="Screenshot placeholder">SCREENSHOT — TO COME</div>
    </div>
    <a class="btn" href="/media">Media &amp; press kit</a>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    text-align: center;
    padding: var(--topbar-h) 1rem 2.5rem;
  }
  /* Subtle animated grid — the "enterthegungeon" flavor, done in pure CSS */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--c-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    animation: drift 40s linear infinite;
    mask-image: radial-gradient(ellipse at 50% 40%, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 25%, transparent 75%);
  }
  @keyframes drift { to { background-position: 48px 96px; } }

  .eyebrow {
    color: var(--c-accent);
    font-size: var(--size-small);
    letter-spacing: 0.35em;
    text-transform: uppercase;
  }
  .title {
    font-size: var(--size-hero);
    letter-spacing: 0.18em;
    margin: 0;
  }
  .sub { color: var(--c-muted); max-width: 34rem; }
  .cta { display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; }

  .sec { padding-block: var(--pad-y); border-top: 1px solid var(--c-line); text-align: center; }
  .sec .lead { max-width: 44rem; margin-inline: auto; }
  .lead em { color: var(--c-accent); font-style: normal; }

  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
    text-align: left;
  }
  .char {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    padding: 1.25rem;
  }
  .char h3 { margin: 1rem 0 0.5rem; }
  .char p { color: var(--c-muted); margin: 0; }
  .portrait {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    letter-spacing: 0.3em;
    font-size: 0.8rem;
  }

  .pillars {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2rem 0 0;
    padding: 0;
    text-align: left;
  }
  .pillars h3 { font-size: 1.05rem; }
  .pillars p { color: var(--c-muted); margin: 0; }

  .shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 2rem 0;
  }
  .shot {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--c-surface-2);
    border: 1px solid var(--c-line);
    color: var(--c-muted);
    letter-spacing: 0.25em;
    font-size: 0.75rem;
  }

  @media (max-width: 720px) {
    .duo, .pillars, .shots { grid-template-columns: 1fr; }
  }
</style>