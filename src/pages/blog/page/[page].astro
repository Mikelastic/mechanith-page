---
// src/pages/blog/page/[page].astro — pages 2..N (page 1 is /blog itself)
import BlogIndexPage from '../../../templates/BlogIndexPage.astro';
import { getPublishedPosts, PAGE_SIZE } from '../../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  // Generate ONLY pages 2..N; /blog/page/1 never exists as a route
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const { page } = Astro.params;
---
<BlogIndexPage locale="en" page={Number(page)} />